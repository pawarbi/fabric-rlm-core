# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
wheels/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Environments
.venv/
venv/
env/
.env
.envrc

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Project scratch: root-level underscore-prefixed files/dirs only. Scoped to
# the repo root (leading /) so package files like fabric_rlm/_worker.py can
# never be accidentally ignored.
/_*

# Local-only scratch tree: experiments, notebooks, benches, research notes.
# Anything inside _local/ is for the maintainer's machine only and must
# never enter the published package or git history.
_local/

# Notebook checkpoints
.ipynb_checkpoints/

# agent-skills (local development only, not part of the repo)
.github/skills/
.github/agents/
.github/copilot-instructions.md
.claude/
.agents/
.copilot/

